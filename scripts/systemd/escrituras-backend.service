[Unit]
Description=Backend FastAPI - Sistema de Borradores de Escrituras Publicas
After=network.target

[Service]
Type=simple
# Ajuste el usuario y rutas según su instalación en Ubuntu
User=www-data
Group=www-data
WorkingDirectory=/opt/sistema-borradores-escrituras/backend
Environment="PATH=/opt/sistema-borradores-escrituras/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
ExecStart=/opt/sistema-borradores-escrituras/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2

# Políticas de reinicio en fallos
Restart=always
RestartSec=5s

# Seguridad y aislamiento de proceso en systemd
NoNewPrivileges=true
PrivateTmp=true

# Bitácoras manejadas por journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=escrituras-backend

[Install]
WantedBy=multi-user.target
